{
  "name": "miku-ms-office-core",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.json",
    "build:bundle": "node scripts/build-library-bundle.mjs",
    "build:all": "npm run build && npm run build:bundle",
    "smoke:bundle": "node scripts/smoke-library-bundle.mjs",
    "test": "npm run build --silent && vitest run",
    "test:unit": "npm run build --silent && vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}

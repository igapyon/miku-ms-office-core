{
  "name": "miku-ms-office-core",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.json",
    "build:bundle": "node scripts/build-library-bundle.mjs && npm run build:types",
    "build:all": "npm run build && npm run build:bundle",
    "build:types": "node scripts/build-library-types.mjs",
    "test:types": "node scripts/verify-library-types.mjs",
    "verify:staged-assets": "node scripts/verify-staged-assets.mjs",
    "test:browser": "npm run verify:staged-assets && node scripts/build-browser-harness.mjs && playwright test",
    "prepare:release-assets": "node scripts/prepare-release-assets.mjs",
    "verify:release-assets": "node scripts/verify-release-assets.mjs",
    "verify:consumer-assets": "node scripts/verify-consumer-assets.mjs",
    "smoke:bundle": "node scripts/smoke-library-bundle.mjs",
    "test": "npm run build --silent && vitest run",
    "test:unit": "npm run build --silent && vitest run",
    "test:watch": "vitest"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.10.2",
    "dts-bundle-generator": "9.5.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
